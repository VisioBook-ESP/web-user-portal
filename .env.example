# Example environment variables for VisioBook Web Portal
# core-user-service runs on port 8080 by default
VITE_API_URL=http://localhost:8080/api/v1

# core-payment-service runs on port 8087 by default
VITE_PAYMENT_API_URL=http://localhost:8087/api/v1

# Stripe publishable key (test mode key — safe to expose in frontend)
# Get from https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXX

# NOTE: STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are backend-only credentials.
# Configure them in core-payment-service environment, never in this frontend.
